# PostgreSQL
POSTGRES_USER=meetflow_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=meetflow_ai
DATABASE_URL=postgresql+psycopg://meetflow_user:change-this-password@localhost:5432/meetflow_ai

# JWT (JSON Web Token)
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_AI_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Audio Upload
UPLOAD_DIR=uploads/audio
MAX_AUDIO_MB=25

# Cookie Security
# Local HTTP: false / Production HTTPS: true
COOKIE_SECURE=false
