# FastAPI 백엔드용 이미지
FROM python:3.11-slim

WORKDIR /code

# 패키지 설치를 먼저 (코드보다 자주 안 바뀌므로 캐시 활용)
COPY requirements.docker.txt /code/requirements.docker.txt
RUN pip install --no-cache-dir -r /code/requirements.docker.txt

# 프로젝트 전체 코드 복사
# (database, models.py, repositories, routers, schema, services, main.py 등
#  main.py가 상대 경로가 아니라 프로젝트 루트 기준으로 import하고 있으므로
#  전체를 그대로 복사해야 함)
COPY . /code

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
